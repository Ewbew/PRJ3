(DELAYFILE
 (SDFVERSION "IEEE 1497 4.0")
 (DATE "2025-04-30T12:25:42Z")
 (DESIGN "stepper with timer")
 (VENDOR "Cypress Semiconductor")
 (PROGRAM "PSoC Creator")
 (VERSION " 4.4")
 (DIVIDER .)
 (TIMESCALE 1 ns)
 (CELL
  (CELLTYPE "stepper with timer")
  (INSTANCE *)
  (DELAY
   (ABSOLUTE
    (INTERCONNECT ClockBlock.clk_bus_glb isr_timer.clock (0.000:0.000:0.000))
    (INTERCONNECT \\Timer_1\:TimerHW\\.tc isr_timer.interrupt (3.425:3.425:3.425))
    (INTERCONNECT __ONE__.q \\Timer_1\:TimerHW\\.enable (0.000:0.000:0.000))
    (INTERCONNECT ClockBlock.dclk_glb_ff_0 \\Timer_1\:TimerHW\\.clock (0.000:0.000:0.000))
    (INTERCONNECT StepPin\(0\)_PAD StepPin\(0\).pad_in (0.000:0.000:0.000))
    (INTERCONNECT DirPin\(0\)_PAD DirPin\(0\).pad_in (0.000:0.000:0.000))
   )
  )
 )
)
